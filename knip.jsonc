{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": [
    "out/{main,preload}/index.js!",
    "src/main/index.ts",
    "src/renderer/index.tsx",
    "src/**/*.{test,spec}.{ts,tsx}",
    "test/**/*.{ts,tsx}"
  ],
  "project": ["*.{js,mjs,ts}", "out/**/*.js!", "src/**/*.{ts,tsx}"],

  // The E2E scripts are run from the pnpm scripts by path, not as installed binaries
  "ignoreBinaries": [
    "electron-rebuild",
    "yq",
    "e2e/scripts/cluster-down.sh",
    "e2e/scripts/cluster-up.sh",
    "e2e/scripts/demo-down.sh",
    "e2e/scripts/demo-up.sh",
    "e2e/scripts/e2e.sh",
    "e2e/scripts/pre-review.sh"
  ],
  "ignoreDependencies": [
    // used as vite plugin
    "@babel/plugin-proposal-decorators"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  "vite": {
    "config": ["electron.vite.config.js"]
  },

  "exclude": ["exports"]
}
