{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": [
    "out/{main,preload}/index.js!",
    "src/main/index.ts",
    "src/renderer/index.tsx",
    "src/**/*.{test,spec}.{ts,tsx}",
    "test/**/*.{ts,tsx}"
  ],
  "project": ["*.{js,mjs,ts}", "out/**/*.js!", "src/**/*.{ts,tsx}"],

  "ignoreBinaries": ["electron-rebuild", "yq"],
  "ignoreDependencies": [
    // used as vite plugin
    "@babel/plugin-proposal-decorators",
    // provided by the Freelens host as globals (see the globalExternals
    // mapping in electron.vite.config.js) and imported again by the KubeSwift
    // views as they are implemented
    "mobx",
    "mobx-react"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  "vite": {
    "config": ["electron.vite.config.js"]
  },

  "exclude": ["exports"]
}
